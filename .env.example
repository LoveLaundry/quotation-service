# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
# DATABASE_URL=mongodb://localhost:27017

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_DB_NAME=quotations_db
MONGODB_COLLECTION=quotations

# ─── JWT (must be identical across all services) ─────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Encryption (must be identical across all services) ──────────────────────
MASTER_KEY=change-me-in-production

# ─── Public chatbot reply engine (lovelaundry-bot on Vercel) ─────────────────
# Base URL of the deployed bot. quotation-service calls <CHAT_BOT_URL>/api/chat
# for replies (unless an admin has taken over the conversation).
CHAT_BOT_URL=https://your-love-bot.vercel.app
# Optional: set on BOTH services to require x-api-key on the bot endpoint.
CHAT_API_KEY=

# ─── Timezone ───────────────────────────────────────────────────────────────
# All business days, reports and "today" run on Sri Lanka time. The code pins
# this itself (see app_time.py), so this only matters for anything that falls
# back to the host clock — logs, third-party libs, `date` in a shell.
TZ=Asia/Colombo
